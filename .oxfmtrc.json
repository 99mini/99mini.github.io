{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": ["dist/**", ".ssr/**", "src/routeTree.gen.ts"]
}
