{
  "name": "99mini.github.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:client && pnpm typecheck && pnpm build:ssr && pnpm prerender",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.29",
    "date-fns": "^4.4.0",
    "es-hangul": "^2.4.0",
    "es-toolkit": "^1.51.0",
    "overlay-kit": "^1.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.32",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "packageManager": "pnpm@11.22.0"
}
